# Copy to .env and fill in. docker compose reads it automatically.
#
# The ones marked REQUIRED are the ones the stack refuses to start without.
# Everything else degrades rather than fails: no SMTP means aftercare and
# password resets are written to the log instead of sent, no Twilio means
# directors copy the family link by hand, no Stripe means nobody can subscribe.

# --- REQUIRED ---------------------------------------------------------------

# Postgres. The password is only used inside the compose network — the
# database port is not published — but it still ends up in DATABASE_URL.
POSTGRES_USER=funeral
POSTGRES_PASSWORD=
POSTGRES_DB=funeral_home

# 32 bytes, base64. Encrypts every uploaded file and every SSN at rest.
# Generate one:  pnpm --filter @workspace/scripts run generate-encryption-key
#
# Losing this loses the photographs — the ciphertext in the database and the
# backups is unreadable without it. Keep a copy somewhere that is not this
# host and not the backup, or the backup is decoration.
# Changing it does not re-encrypt anything: existing files stop opening.
ENCRYPTION_KEY=

# Public URLs of the three front ends. The API builds the links it texts and
# emails from the first two, and Caddy gets a TLS certificate for each of the
# three, so these are the only place the hostnames are written down. Each
# needs a DNS record pointing at this host before the first start.
# Include the scheme, no trailing slash.
FAMILY_PORTAL_URL=https://family.continuumaftercare.com
CONSOLE_URL=https://console.continuumaftercare.com
ADMIN_CONSOLE_URL=https://admin.continuumaftercare.com

# The bare domain, and www. This is the address somebody is given verbally or
# reads off a card, and without it that address reaches nothing at all.
#
# Caddy redirects both to CONSOLE_URL, which is the one sign-in screen that can
# sort out whoever arrives: staff sign in there, a platform admin is passed on
# to their own console, and a family is pointed at the portal, because their
# texted link is the credential and no password would ever have worked.
#
# Each needs its own DNS record and gets its own certificate, like the other
# three. If you do not want the bare domain served, delete these two lines and
# the two blocks at the end of deploy/Caddyfile.
ROOT_URL=https://continuumaftercare.com
WWW_URL=https://www.continuumaftercare.com

# Let's Encrypt writes here if a certificate is about to expire and renewal
# has stopped working. A real inbox somebody reads.
ACME_EMAIL=

# The first platform admin, so a fresh deployment's admin console is
# reachable. Read once, on the first start, into an empty platform_admins
# table; after that it is ignored and admins are managed from the console.
# The address must also register a staff account in the director console.
PLATFORM_ADMIN_EMAILS=

# --- Email (password resets, aftercare check-ins) ---------------------------
# Without these the mail is written to the API log and nothing is delivered.
# Set all four; with only some set, nothing is sent and the log says which is
# missing. DEPLOY.md, "Email", has the values for the common providers and the
# DNS records that keep mail out of spam. Then prove it works:
#   docker compose run --rm tools pnpm --filter @workspace/scripts run send-test-email -- you@example.com
#
# SMTP_FROM is what a grieving family sees as the sender, and must be on a
# domain the provider has verified. With an API-key provider (Postmark,
# SendGrid, Resend) it is required: SMTP_USER there is not an address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (family links and aftercare texts) ---------------------------------
# The platform's parent Twilio account. Each home can then get its own
# subaccount and 10DLC-registered messaging service from the admin console;
# until that is approved, texts go from a verified toll-free number or from
# the shared sender below (a messaging service is preferred to one number).
# Nobody is texted without recorded consent, and STOP/HELP replies arrive at
# TWILIO_WEBHOOK_URL, which must be exactly what Twilio is configured to call
# (it is part of the signature): https://<api host>/api/webhooks/twilio/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_URL=
SMS_DEFAULT_COUNTRY_CODE=+1

# --- Billing ----------------------------------------------------------------
# The free trial every subscribe button starts, in days. No card and no
# Stripe account are needed for it. 0 switches it off.
FREE_TRIAL_DAYS=30

# STRIPE_WEBHOOK_SECRET is what makes the webhook trustworthy; without it the
# endpoint rejects everything, which is the correct failure — an unverified
# webhook is an open door to marking any home paid.
# Prices ($169/location/month, $7/funeral, annual two months free) are
# created from lib/db/src/price-book.ts by
#   pnpm --filter @workspace/scripts run stripe-setup -- --apply
# which prints the STRIPE_PRICE_ID* values below. Until they are set, every
# subscribe button starts the free trial and nothing else changes.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_WEBHOOK_SECRET=

# The per-case charge. Both of these or neither: a metered price with no
# meter event name invoices every home for zero funerals a month and looks,
# from the inside, exactly like a product nobody is using.
#
# STRIPE_PRICE_ID_CASE is a *metered* recurring price on the same product;
# STRIPE_CASE_METER_EVENT is the `event_name` of the Stripe meter behind it.
# Leave both empty to sell a flat subscription — that is a supported
# configuration, not a half-finished one.
STRIPE_PRICE_ID_CASE=
STRIPE_PRICE_ID_CASE_ANNUAL=
STRIPE_CASE_METER_EVENT=
# The meter's id (mtr_...), for stripe-setup to attach the metered prices to.
STRIPE_CASE_METER_ID=

# Aftercare is part of the base plan (PRICING.md), so leave this empty. Set it
# only to sell aftercare as its own line: closing a case then enrols a family
# only if the home's subscription carries this price.
#
# Families already enrolled keep receiving their check-ins either way. That
# is not configurable and is not meant to be.
STRIPE_PRICE_ID_AFTERCARE=

# --- Optional ---------------------------------------------------------------
# Suggested obituary rewrites, for directors only. Off while this is empty.
# When set, a director can send one case's obituary fields for a suggestion
# after confirming; nothing reaches the family unless a director uses it.
ANTHROPIC_API_KEY=
OBITUARY_AI_MODEL=claude-opus-5-5

# Nationwide business lookup for the vendor directory. Without it the
# directory still works from what the home enters by hand, and reports
# "not configured" rather than pretending it found nothing nearby.
GOOGLE_PLACES_API_KEY=

# Shared secret for the scheduled-task endpoints (the aftercare sender and
# the usage reporter). Any long random string; without it those endpoints
# refuse every caller.
TASK_SECRET=

# Comma-separated allowlist. Leave empty in the normal deployment: the apps
# and the API are same-origin behind nginx. There is deliberately no wildcard.
CORS_ORIGINS=

LOG_LEVEL=info
BACKUP_RETAIN_DAYS=30

# --- The public website (optional) -----------------------------------------
# Off unless you ask for it. To serve it: set WEBSITE_URL, add a DNS record
# for it, and add "website" to COMPOSE_PROFILES (or pass --profile website).
# All of these are baked in at build time: change one, then
# `docker compose build website`. DEPLOY.md, "Website", has the rest.
#COMPOSE_PROFILES=website
WEBSITE_URL=
# Where "Talk to us" and the pricing and legal notes send a funeral home.
WEBSITE_CONTACT_EMAIL=
# Leave these empty until the documents in LEGAL/ have been through a lawyer;
# until then the footer says they are available on request.
WEBSITE_PRIVACY_URL=
WEBSITE_TERMS_URL=
