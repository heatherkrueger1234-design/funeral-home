{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Generated from an OpenAPI spec whose multipart bodies are typed as
    // File/Blob. Those are part of the contract these packages describe.
    "lib": ["es2022", "dom"],
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
