# Copy to .env and fill in. docker compose reads it automatically.
#
# The four marked REQUIRED are the ones the stack refuses to start without.
# Everything else degrades rather than fails: no SMTP means aftercare and
# password resets are written to the log instead of sent, no Twilio means
# directors copy the family link by hand, no Stripe means nobody can subscribe.

# --- REQUIRED ---------------------------------------------------------------

# Postgres. The password is only used inside the compose network — the
# database port is not published — but it still ends up in DATABASE_URL.
POSTGRES_USER=funeral
POSTGRES_PASSWORD=
POSTGRES_DB=funeral_home

# 32 bytes, base64. Encrypts every uploaded file and every SSN at rest.
# Generate one:  pnpm --filter @workspace/scripts run generate-encryption-key
#
# Losing this loses the photographs — the ciphertext in the database and the
# backups is unreadable without it. Keep a copy somewhere that is not this
# host and not the backup, or the backup is decoration.
# Changing it does not re-encrypt anything: existing files stop opening.
ENCRYPTION_KEY=

# Public URLs of the two front ends, used to build the links that go out in
# texts and emails. Wrong values here send families to a page that does not
# exist. Include the scheme, no trailing slash.
FAMILY_PORTAL_URL=https://family.example.com
CONSOLE_URL=https://console.example.com

# --- Ports the host publishes ----------------------------------------------
FAMILY_PORTAL_PORT=8080
CONSOLE_PORT=8081

# --- Email (password resets, aftercare check-ins) ---------------------------
# Without these the mail is written to the API log and nothing is delivered.
# SMTP_FROM is what a grieving family sees as the sender, so use an address
# that belongs to the home, not to this software.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (sending the asset-drop link to the next of kin) -------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+1

# --- Billing ----------------------------------------------------------------
# STRIPE_WEBHOOK_SECRET is what makes the webhook trustworthy; without it the
# endpoint rejects everything, which is the correct failure — an unverified
# webhook is an open door to marking any home paid.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------
# Nationwide business lookup for the vendor directory. Without it the
# directory still works from what the home enters by hand, and reports
# "not configured" rather than pretending it found nothing nearby.
GOOGLE_PLACES_API_KEY=

# Shared secret for the scheduled-task endpoints (the aftercare sender).
# Any long random string; without it those endpoints refuse every caller.
TASK_SECRET=

# Comma-separated allowlist. Leave empty in the normal deployment: the apps
# and the API are same-origin behind nginx. There is deliberately no wildcard.
CORS_ORIGINS=

LOG_LEVEL=info
BACKUP_RETAIN_DAYS=30
