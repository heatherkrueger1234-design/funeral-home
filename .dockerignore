# Keep the build context small and keep secrets out of it. Everything the
# image needs is either a manifest or source; anything built on a developer's
# machine is rebuilt inside the image against the right libc and node version.

.git
.github
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets. A .env copied into the context ends up in an image layer, and image
# layers travel.
.env
.env.*
!.env.example
*.pem
*.key

# Database dumps. These hold everything every family has written. (And the
# row counts beside each, which do not, but go where their backup goes.)
backups/
*.sql
*.sql.partial
*.sql.enc
*.sql.enc.partial
*.sql.enc.counts.json
*.sql.enc.verify-*.tmp
*.sql.enc.restore-*.tmp

.DS_Store
Thumbs.db
coverage
.vscode
.idea
.cache
.local
