# Serves the public website: one prerendered page, its stylesheet, fonts and
# screenshots. Used in place of nginx.conf.template when Dockerfile.web is
# built with NGINX_CONF=deploy/website.conf.template (docker-compose.yml's
# `website` service does this).
#
# Two differences from the apps' config, both deliberate:
#
#   - No /api proxy. The website talks to nothing; it links to the console.
#   - It is meant to be found. The apps send X-Robots-Tag: noindex on every
#     response because a page naming someone who has just died must never be
#     indexed; this page names nobody real and exists to be indexed, so its
#     headers come from website-security-headers.conf, which leaves that out.
#
# Holds no NGINX_ variables, so the image's envsubst step passes it through
# unchanged; it is a .template only so it lands where the image expects one.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;
    gzip_min_length 1024;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Fingerprinted by Vite: the bytes at a URL never change.
    location /assets/ {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Screenshots are not fingerprinted (the page names them directly), so a
    # week rather than a year: long enough to be fast, short enough that a
    # re-shot screen reaches everyone.
    location /screens/ {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # One page. Anything that is not a file is a 404, not the page again:
    # answering every URL with the home page tells search engines that the
    # site has infinitely many copies of itself.
    location / {
        try_files $uri $uri/ =404;
    }
}
