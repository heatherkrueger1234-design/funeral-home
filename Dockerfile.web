# Either front end, behind nginx.
#
#   docker build -f Dockerfile.web --build-arg APP=family-portal    -t fh-family  .
#   docker build -f Dockerfile.web --build-arg APP=director-console  -t fh-console .
#   docker build -f Dockerfile.web --build-arg APP=admin-console     -t fh-admin   .
#
# One Dockerfile for all three because they are the same build: a Vite SPA
# that talks to /api on its own origin. Giving each its own file would mean
# three places to fix the next time the nginx config is wrong.

ARG APP=family-portal

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS build
ARG APP

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY artifacts/admin-console/package.json ./artifacts/admin-console/
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/director-console/package.json ./artifacts/director-console/
COPY artifacts/family-portal/package.json ./artifacts/family-portal/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/db/package.json ./lib/db/
COPY lib/mailer/package.json ./lib/mailer/
COPY scripts/package.json ./scripts/

RUN pnpm install --frozen-lockfile

COPY . .

# The workspace libraries are consumed as built declarations, so they have to
# exist before Vite resolves them.
RUN pnpm run typecheck:libs

# BASE_PATH defaults to "/" in vite.config.ts, which is right here: each app
# gets its own hostname rather than a path prefix. PORT is not set because the
# build does not need one — nginx does the serving.
ENV NODE_ENV=production
# The one build-time value: the director console prints the home's public
# page address for them to put on their own website, and only the deployment
# knows the family portal's hostname. Without it the console could only show
# "/start/<slug>" and ask a funeral director to assemble a URL by hand.
# Harmless for the other two apps, which never read it.
ARG VITE_FAMILY_PORTAL_URL=""
ENV VITE_FAMILY_PORTAL_URL=${VITE_FAMILY_PORTAL_URL}
RUN pnpm --filter "@workspace/${APP}" run build

# Pin the output path for the next stage: COPY --from cannot expand an ARG in
# the middle of a path on every builder, and a wrong path here silently ships
# an empty site.
RUN mkdir -p /site && cp -r "/app/artifacts/${APP}/dist/public/." /site/

# ---------------------------------------------------------------------------
# Serve
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# The nginx image expands templates/*.template with envsubst at container
# start. NGINX_ENVSUBST_FILTER keeps it to NGINX_-prefixed names, so nginx's
# own $host, $uri and $upstream_api are not eaten by the substitution.
ENV NGINX_ENVSUBST_FILTER=^NGINX_
ENV NGINX_RESOLVER=127.0.0.11
ENV NGINX_API_ORIGIN=http://api:4311

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
# Not a template: it holds no NGINX_ variables, and the locations that
# include it need it at a fixed path rather than an expanded one.
COPY deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /site /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
